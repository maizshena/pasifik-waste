{
  "expo": {
    "name": "Pasifik Waste",
    "slug": "pasifik-waste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#73AF6F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "id.pasifik.waste",
      "infoPlist": {
        "NSCameraUsageDescription": "Pasifik needs camera access to photograph your waste.",
        "NSPhotoLibraryUsageDescription": "Pasifik needs photo library access to attach waste photos.",
        "NSLocationWhenInUseUsageDescription": "Pasifik needs your location to tag your waste report."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#73AF6F"
      },
      "package": "id.pasifik.waste",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pasifik needs access to your photos to attach waste documentation."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "pasifik",
    "experiments": {
      "typedRoutes": true
    }
  }
}
